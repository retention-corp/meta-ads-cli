# Routines configuration. Copy to .env and fill in.

# Slack incoming webhook (https://api.slack.com/messaging/webhooks).
# Leave empty to fall back to stdout (the routines still run).
SLACK_WEBHOOK_URL=

# Optional: override channel if your webhook isn't channel-locked.
# SLACK_CHANNEL=#ads-morning-brief

# Page ID used by creative_pipeline when --execute is set.
META_PAGE_ID=1534124060211977

# Ad set where new test ads land (PAUSED). Required only with EXECUTE=1.
# CREATIVE_TEST_ADSET_ID=120240782421490025

# Defaults for creative_pipeline --execute.
# CREATIVE_LINK=https://example.com
# CREATIVE_HEADLINE=Test
